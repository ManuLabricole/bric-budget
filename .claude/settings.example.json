{
  "_comment": "TEMPLATE PUBLIC — copier vers settings.json (gitignoré) et adapter. additionalDirectories accepte un chemin relatif au projet ou absolu.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "WebSearch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(make *)",
      "Bash(poetry *)",
      "Bash(docker compose *)",
      "Bash(poetry run pytest *)",
      "Bash(poetry run ruff check *)",
      "Bash(poetry run djlint *)",
      "Bash(unset GITHUB_TOKEN)",
      "Bash(unset GITHUB_TOKEN && gh pr *)",
      "Bash(unset GITHUB_TOKEN && gh issue *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(railway *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir -p *)"
    ],
    "additionalDirectories": [
      ".claude"
    ]
  },
  "enableAllProjectMcpServers": true,
  "_comment_hooks": "PostToolUse : ruff format auto du .py édité (en plus du pre-commit). Script : .claude/hooks/ruff_format.sh",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff_format.sh"
          }
        ]
      }
    ]
  }
}
