# Copier ce fichier en .env.local et remplir les valeurs
# .env.local ne doit JAMAIS être commité dans Git

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=bricbudget
DB_USER=bricbudget
DB_PASSWORD=bricbudget
DB_HOST=localhost
DB_PORT=5432

# Superuser (pour make superuser — ne jamais commiter les vraies valeurs)
SUPERUSER_EMAIL=ton@email.com
SUPERUSER_PASSWORD=ton_mot_de_passe

# Identifiants bancaires pour seed_initial.py
# Ces valeurs ne doivent JAMAIS être dans le code source — uniquement ici

# UBS : IBAN normalisé (sans espaces) tel qu'il apparaît dans le fichier CSV UBS
UBS_IBAN_NORMALISED=CH9XXXXXXXXXXXXXXXXXXX
# UBS : IBAN avec espaces pour affichage dans l'UI
UBS_IBAN_DISPLAY=CH9X XXXX XXXX XXXX XXXX X

# CIC : RIB normalisé (sans espaces) par compte — visible dans le fichier Excel CIC
CIC_CC_CONTRACT=XXXXXXXXXXXXXXXXXXXXXXXXXXX
CIC_LIVRET_CONTRACT=XXXXXXXXXXXXXXXXXXXXXXXXXXX
CIC_LDDS_CONTRACT=XXXXXXXXXXXXXXXXXXXXXXXXXXX
