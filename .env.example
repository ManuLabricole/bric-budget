# ─────────────────────────────────────────────────────────────────────────────
# BricBudget — variables d'environnement
#
# USAGE :
#   • Local  : copier en .env, remplir les vraies valeurs
#   • Railway: copier chaque variable dans Dashboard → Service → Variables
#
# ⚠️  Ne JAMAIS commiter .env avec de vraies valeurs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────

# URL secrète de l'interface admin (sans slash de fin).
# Local  : "admin" suffit
# Railway: choisir un chemin non-devinable (ex: "manage-a3f9c2")
ADMIN_URL=admin

# Clé secrète Django — signe les sessions, tokens CSRF, liens de reset de mdp.
# Générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Local  : n'importe quelle valeur longue
# Railway: générer une nouvelle clé dédiée prod (ne jamais réutiliser la clé locale)
SECRET_KEY=

# Local : True (pages d'erreur détaillées)
# Railway: False (obligatoire — sinon Django affiche le code source en clair)
DEBUG=True

# Domaines autorisés à faire des requêtes.
# Local  : localhost,127.0.0.1
# Railway: Railway injecte RAILWAY_PUBLIC_DOMAIN automatiquement — pas besoin de l'ajouter ici
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local uniquement — Railway utilise DATABASE_URL injectée automatiquement.
# Ne pas mettre ces variables sur Railway.
DB_NAME=bricbudget
DB_USER=bricbudget
DB_PASSWORD=bricbudget
DB_HOST=localhost
DB_PORT=5432

# ── Superuser ─────────────────────────────────────────────────────────────────
# Compte admin créé par : poetry run python src/manage.py seed_initial
# Local  : utiliser ton vrai email
# Railway: à renseigner pour le premier déploiement, puis peut être retiré
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# ── Chiffrement fichiers d'import ─────────────────────────────────────────────
# Clé Fernet (AES-128-CBC + HMAC-SHA256) — chiffre les CSV/Excel uploadés sur disque.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Local  : générer une clé et la garder
# Railway: générer une clé dédiée prod (fresh start — pas de fichiers à migrer)
# ⚠️  Si tu changes cette clé, tous les fichiers déjà uploadés deviennent illisibles.
IMPORT_ENCRYPTION_KEY=

# ── Railway MCP ───────────────────────────────────────────────────────────────
# Token pour le MCP Railway (outil de gestion infra dans Claude Code).
# Local uniquement — ne jamais mettre ce token dans les variables Railway.
# Générer : railway login → Account Settings → Tokens → New Token
RAILWAY_TOKEN=
