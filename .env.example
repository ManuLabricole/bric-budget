# Copier ce fichier en .env.local et remplir les valeurs
# .env.local ne doit JAMAIS être commité dans Git

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=bricbudget
DB_USER=bricbudget
DB_PASSWORD=bricbudget
DB_HOST=localhost
DB_PORT=5432

# Superuser (pour make superuser — ne jamais commiter les vraies valeurs)
SUPERUSER_EMAIL=ton@email.com
SUPERUSER_PASSWORD=ton_mot_de_passe

# ── Comptes bancaires pour seed_accounts ──────────────────────────────────────
# Ces valeurs ne doivent JAMAIS être dans le code source — uniquement ici.
# Lancer : python manage.py seed_accounts  (après seed_banks)
# Toutes les valeurs sont optionnelles — les champs vides → is_complete=False.

# Yuh (CHF — checking)
# Pas d'identifiant dans le fichier CSV, tout est renseigné manuellement ici.
YUH_ACCOUNT_NAME=Compte Yuh
YUH_IBAN=CH56XXXXXXXXXXXXXXXXXXXXXXX
YUH_BIC=YUHHCHZZ

# UBS (CHF — checking)
# L'IBAN est extrait du fichier CSV à l'import, mais on le pré-renseigne ici.
UBS_ACCOUNT_NAME=UBS Compte courant
UBS_IBAN=CH56XXXXXXXXXXXXXXXXXXXXXXX
UBS_BIC=UBSWCHZH80A

# CIC — Compte courant (EUR — checking)
# RIB extrait automatiquement du fichier Excel CIC (feuille "Compte courant").
CIC_CC_NAME=Compte courant
CIC_CC_RIB=XXXXXXXXXXXXXXXXXXXXXXXXXXX
CIC_CC_IBAN=FR76XXXXXXXXXXXXXXXXXXXXXXXXXXXX
CIC_CC_BIC=CMCIFRPP

# CIC — Livret A (EUR — savings)
CIC_LA_NAME=Livret A
CIC_LA_RIB=XXXXXXXXXXXXXXXXXXXXXXXXXXX
CIC_LA_IBAN=
CIC_LA_BIC=CMCIFRPP

# CIC — LDDS (EUR — savings)
CIC_LDDS_NAME=LDDS
CIC_LDDS_RIB=XXXXXXXXXXXXXXXXXXXXXXXXXXX
CIC_LDDS_IBAN=
CIC_LDDS_BIC=CMCIFRPP

# ── Chiffrement fichiers d'import ────────────────────────────────────────────
# Clé Fernet obligatoire pour l'upload web. Les fichiers CSV/Excel bancaires
# sont chiffrés (AES-128-CBC + HMAC-SHA256) avant d'être stockés sur disque.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IMPORT_ENCRYPTION_KEY=

# ── Railway — MCP ────────────────────────────────────────────────────────────
# Token Railway pour le MCP de gestion des déploiements (CTO uniquement)
# Générer : Account Settings → Tokens → New Token (scope: account)
# ⚠️  Ne jamais commiter ce fichier avec un vrai token
RAILWAY_TOKEN=