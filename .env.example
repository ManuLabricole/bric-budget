# ─────────────────────────────────────────────────────────────────────────────
# BricBudget — variables d'environnement
#
# USAGE
# ─────
# Local  : cp .env.example .env  →  remplir les valeurs  →  ne jamais commiter
# Railway: entrer chaque variable dans Dashboard → Service bric-budget → Variables
#          (pas le service Postgres — celui de l'app Django)
#
# ⚠️  Ne JAMAIS commiter .env avec de vraies valeurs.
# ─────────────────────────────────────────────────────────────────────────────


# ── Django ────────────────────────────────────────────────────────────────────

# URL secrète de l'interface admin Django.
# Sans ça, /admin/ est accessible à tout le monde et signale que l'app est Django.
# Local  : "admin" suffit (pratique)
# Railway: choisir un chemin non-devinable, ex: "gestion-a3f9c2"
#          → l'attaquant qui essaie /admin/ tombe sur une 404
ADMIN_URL=

# Clé secrète Django — signe les sessions, les tokens CSRF et les liens de
# réinitialisation de mot de passe. Compromettre cette clé = compromettre l'app.
# Générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Local  : n'importe quelle valeur longue
# Railway: générer une nouvelle clé dédiée (ne jamais réutiliser la clé locale)
SECRET_KEY=

# Contrôle le mode de l'app Django.
# True  → pages d'erreur détaillées avec stack trace (dev uniquement)
# False → page 500 générique, aucune info interne exposée (obligatoire en prod)
# Local  : True
# Railway: False  ← OBLIGATOIRE
DEBUG=True

# Domaines que Django accepte de servir. Requête avec un Host: autre → 400.
# Protège contre les attaques d'injection d'en-tête Host.
# Local  : localhost,127.0.0.1
# Railway: pas besoin — RAILWAY_PUBLIC_DOMAIN est injecté automatiquement
#          par Railway et ajouté à cette liste dans settings.py
ALLOWED_HOSTS=localhost,127.0.0.1


# ── PostgreSQL ────────────────────────────────────────────────────────────────
#
# Convention 12-factor app : une seule variable décrit toute la connexion DB.
# Format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# Local  : pointer vers le container Docker (port 5433 côté Mac)
#          → postgresql://bricbudget:bricbudget@localhost:5433/bricbudget
#          Note: port 5433 car 5432 est pris par PostgreSQL Homebrew sur ce Mac.
#                À l'intérieur du container Docker, PostgreSQL écoute sur 5432.
#
# Railway: NE PAS remplir cette variable manuellement.
#          Dans le service bric-budget → Variables → Add Variable Reference
#          → sélectionner DATABASE_URL du service Postgres.
#          Railway l'injecte automatiquement avec les bons credentials.
#          Si les credentials Postgres changent, DATABASE_URL se met à jour seul.
DATABASE_URL=


# ── Superuser ─────────────────────────────────────────────────────────────────
# Compte administrateur créé par : poetry run python src/manage.py create_user --superuser
# La commande est idempotente : elle ne recrée pas le compte s'il existe déjà.
#
# Local  : utiliser ton vrai email (pratique pour accéder à l'admin)
# Railway: renseigner pour le premier déploiement, puis lancer la commande
#          via Railway Console. Ces variables peuvent être retirées ensuite.
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# ── Démo / seed dev (#118) ────────────────────────────────────────────────────
# User de démo créé par : poetry run python src/manage.py dev_seed (app demo/, DEV only).
# Loginable en local avec ces identifiants. Laisser vide en prod (le seed refuse si vide).
DEMO_USER_EMAIL=demo@bricbudget.local
DEMO_USER_PASSWORD=changeme-dev-only


# ── Stockage fichiers d'import ────────────────────────────────────────────────
# Dossier où sont stockés les fichiers bancaires uploadés via /import/.
#
# Local  : laisser vide → utilise assets/private/data/imports/ (défaut dans settings.py)
# Railway: /mnt/imports  (mount point du Railway Volume attaché au service bric-budget)
#
# Setup Railway Volume :
#   1. Dashboard → Service bric-budget → Storage → Add Volume
#   2. Mount Path : /mnt/imports
#   3. Ajouter cette variable : IMPORT_STORAGE_ROOT=/mnt/imports
#
# Phase future : migrer vers Cloudflare R2 ou AWS S3 (object storage sans état).
IMPORT_STORAGE_ROOT=

# ── Chiffrement fichiers d'import ─────────────────────────────────────────────
# Clé Fernet (AES-128-CBC + HMAC-SHA256).
# Chiffre les fichiers bancaires (CSV/XLS) uploadés via l'UI /import/ au repos.
#
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Local  : générer une clé et la conserver (la perdre = fichiers illisibles)
# Railway: générer une clé dédiée prod (différente de la locale)
#
# Rotation de clé (sans re-chiffrement) :
#   1. Générer une nouvelle clé
#   2. Mettre IMPORT_ENCRYPTION_KEY=nouvelle_clé,ancienne_clé
#   3. Les nouveaux fichiers utilisent la nouvelle clé, les anciens restent lisibles
#   4. Une fois tous les anciens fichiers re-importés → retirer l'ancienne clé
#
# ⚠️  Ne JAMAIS retirer une clé tant que des fichiers chiffrés avec elle existent.
IMPORT_ENCRYPTION_KEY=


# ── Monitoring — Sentry (#259) ────────────────────────────────────────────────
# DSN du projet Sentry → l'app ENVOIE ses erreurs 500 au cloud Sentry.
# Local  : VIDE  → Sentry OFF (init sautée, zéro effet). Ne PAS remplir en dev.
# Railway: coller la DSN (Sentry.io → projet Django → Settings → Client Keys (DSN)).
# Jamais committée.
SENTRY_DSN=

# ── Backups DB → S3 (#257) ────────────────────────────────────────────────────
# La commande dump_db_to_s3 (pre-deploy + cron) sauvegarde la DB dans un bucket.
# Par défaut elle RÉUTILISE le bucket média (vars AWS_* auto-injectées par Railway)
# sous le préfixe db-backups/ → AUCUNE nouvelle var requise pour démarrer.
#
# Rétention (optionnel) : nb de jours avant purge des vieux dumps (défaut 14).
# Local  : VIDE (pas de backup en dev). Railway: optionnel.
DB_BACKUP_RETENTION_DAYS=
#
# BUCKET DÉDIÉ (recommandé, optionnel) : pour isoler les backups du bucket média.
# Créer un 2ᵉ bucket Railway et mapper ses creds vers CES noms (sinon collision avec
# les AWS_* du bucket média). Si AWS_BACKUP_BUCKET_NAME est défini → la commande
# l'utilise ; sinon fallback sur AWS_*. Remplir UNIQUEMENT côté Railway si bucket dédié.
AWS_BACKUP_BUCKET_NAME=
AWS_BACKUP_ENDPOINT_URL=
AWS_BACKUP_ACCESS_KEY_ID=
AWS_BACKUP_SECRET_ACCESS_KEY=
AWS_BACKUP_REGION=


# ─────────────────────────────────────────────────────────────────────────────
# VARIABLES INJECTÉES AUTOMATIQUEMENT PAR RAILWAY (ne pas ajouter manuellement)
# ─────────────────────────────────────────────────────────────────────────────
#
# DATABASE_URL          → injectée via Variable Reference depuis le service Postgres
# RAILWAY_PUBLIC_DOMAIN → injectée par Railway (domaine *.up.railway.app)
# PORT                  → injectée par Railway (port Gunicorn, souvent 8080)
# RAILWAY_ENVIRONMENT_NAME → nom de l'env (production/staging) → tag Sentry
#
# Bucket média (icônes + imports), via "Connect Service to Bucket" → "Add Variables" :
#   AWS_S3_BUCKET_NAME · AWS_ENDPOINT_URL · AWS_ACCESS_KEY_ID ·
#   AWS_SECRET_ACCESS_KEY · AWS_DEFAULT_REGION
#   Présence ⇒ storage S3 (prod) ; absence ⇒ filesystem local (dev). Réutilisées
#   PAR DÉFAUT pour les backups DB (sauf si AWS_BACKUP_* sont définis).
#
# Ces variables n'existent pas en local — settings.py les gère avec des defaults.
# ─────────────────────────────────────────────────────────────────────────────
