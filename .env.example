# ─────────────────────────────────────────────────────────────────────────────
# BricBudget — variables d'environnement
# Copier en .env et remplir les valeurs. Ne JAMAIS commiter .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# URL secrète de l'interface admin (sans slash). En prod : choisir un chemin non-devinable.
# Ex: "gestion-b4f2a1" → l'admin sera sur /gestion-b4f2a1/
ADMIN_URL=admin
# Générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
# Mettre False en production
DEBUG=True
# En prod Railway : votre-domaine.railway.app,votre-domaine-custom.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL (local) ───────────────────────────────────────────────────────
# En production Railway : ces variables sont remplacées par DATABASE_URL (voir settings.py)
DB_NAME=bricbudget
DB_USER=bricbudget
DB_PASSWORD=bricbudget
DB_HOST=localhost
DB_PORT=5432

# ── Superuser ────────────────────────────────────────────────────────────────
# Utilisé par : make superuser / seed_initial.py
SUPERUSER_EMAIL=ton@email.com
SUPERUSER_PASSWORD=ton_mot_de_passe_fort

# ── Comptes bancaires — seed_initial.py ──────────────────────────────────────
# Valeurs optionnelles. Champ vide → is_complete=False (compte créé sans IBAN).
# ⚠️  Vraies valeurs uniquement dans .env local, jamais dans le code.

# UBS (CHF — checking)
# contract_number : IBAN normalisé tel qu'il apparaît dans le fichier CSV UBS (sans espaces)
UBS_IBAN_NORMALISED=CH56XXXXXXXXXXXXXXXXXXXXXXX
# iban : version affichage (avec espaces) pour l'UI
UBS_IBAN_DISPLAY=CH56 XXXX XXXX XXXX XXXX X

# CIC — Compte courant (EUR — checking)
CIC_CC_CONTRACT=XXXXXXXXXXXXXXXXXXXXXXXXXXX

# CIC — Livret A (EUR — savings)
CIC_LIVRET_CONTRACT=XXXXXXXXXXXXXXXXXXXXXXXXXXX

# CIC — LDDS (EUR — savings)
CIC_LDDS_CONTRACT=XXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Chiffrement fichiers d'import ────────────────────────────────────────────
# Clé Fernet (AES-128-CBC + HMAC-SHA256) pour les fichiers CSV/Excel uploadés.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️  Même clé en prod et en local pour pouvoir relire les fichiers existants.
IMPORT_ENCRYPTION_KEY=

# ── Railway ───────────────────────────────────────────────────────────────────
# TOKEN : Account Settings → Tokens → New Token (scope: account)
# Utilisé par le MCP Railway (outil CTO). Ne pas mettre dans les Railway env vars.
RAILWAY_TOKEN=

# URL PostgreSQL injectée automatiquement par Railway en production.
# En local : laisser vide (la DB locale est utilisée via DB_* ci-dessus).
RAILWAY_POSTGRES_URL=
