erDiagram

    %% ==========================================================================
    %% USERS — App users/
    %% Login par email. Profile = préférences UI séparées de l'auth.
    %% ==========================================================================

    CustomUser {
        bigint id PK
        string email UK
        string password_hash
        string first_name
        string last_name
        boolean is_active
        boolean is_staff
        boolean is_superuser
        datetime last_login
        datetime date_joined
    }

    Profile {
        bigint id PK
        bigint user_id FK
        string langue
        string devise_affichage
    }

    %% ==========================================================================
    %% ACCOUNTS — App accounts/
    %% Infrastructure bancaire. AccountAccess SUPPRIMÉ (YAGNI — app 2 users).
    %% Qui utilise quoi = Card.user, pas une table de permissions.
    %% ==========================================================================

    Bank {
        bigint id PK
        string name UK
        string slug UK
        string country
        string default_currency
        boolean is_active
    }

    Account {
        bigint id PK
        bigint bank_id FK
        string name
        string slug UK
        string account_type
        string currency
        boolean is_active
        datetime created_at
    }

    %% Table spécialisée Phase 0A — comptes courants (Yuh, CIC C/C)
    %% Patron : 1 Account → 1 table spécialisée (OneToOne)
    %% Phase 4+ : CompteEpargne, ComptePrevoyance3a, CompteLibrePassage
    %% Phase 5+ : CompteInvestissement

    CompteCourant {
        bigint account_id PK_FK
        string iban
        string bic
    }

    Card {
        bigint id PK
        bigint account_id FK
        bigint user_id FK
        string last_four
        string card_type
        boolean is_active
    }

    BalanceSnapshot {
        bigint id PK
        bigint account_id FK
        date date
        decimal solde
        string currency
        decimal solde_chf
        string source
    }

    ExchangeRate {
        bigint id PK
        date date
        string from_currency
        string to_currency
        decimal rate
    }

    %% ==========================================================================
    %% TRANSACTIONS — App transactions/
    %% ==========================================================================

    Transaction {
        bigint id PK
        bigint account_id FK
        bigint card_id FK
        bigint category_id FK
        bigint subcategory_id FK
        bigint rule_id FK
        date date_transaction
        date date_valeur
        decimal montant
        string devise
        decimal montant_chf
        decimal taux_change_utilise
        string description_brute
        string description_nette
        string localite
        boolean pointe
        string source_categorisation
        decimal confiance_score
        string import_hash
        string import_fichier
        datetime created_at
        datetime updated_at
    }

    Category {
        bigint id PK
        string nom
        string slug UK
        string emoji
        string couleur_hex
        string nature
        int ordre_affichage
        boolean actif
    }

    SubCategory {
        bigint id PK
        bigint category_id FK
        string nom
        string slug
        string emoji
        boolean actif
    }

    CategorizationRule {
        bigint id PK
        bigint category_id FK
        bigint subcategory_id FK
        string keyword
        string champ_cible
        boolean sensible_casse
        int priorite
        int nb_applications
        boolean validee_manuellement
        datetime created_at
    }

    ImportLog {
        bigint id PK
        bigint account_id FK
        bigint user_id FK
        string nom_fichier
        string hash_fichier
        string statut
        int nb_transactions_total
        int nb_nouvelles
        int nb_doublons
        int nb_erreurs
        string detail_erreurs
        datetime importe_le
    }

    BudgetTarget {
        bigint id PK
        bigint category_id FK
        bigint subcategory_id FK
        string periode
        decimal montant_cible
        string recurrence
        boolean actif
    }

    BudgetResult {
        bigint id PK
        bigint target_id FK
        string periode
        decimal montant_realise
        decimal ecart
        boolean objectif_atteint
        string statut
        datetime calcule_le
    }

    %% ==========================================================================
    %% PHASE 4+ — Patrimoine (pas encore implémenté)
    %% ==========================================================================

    %% CompteEpargne { account_id PK_FK, taux_interet_annuel, plafond_legal }
    %% ComptePrevoyance { account_id PK_FK, type_prevoyance, frais_gestion_annuel_pct }
    %% CompteInvestissement { account_id PK_FK, type_etf }

    %% ==========================================================================
    %% PHASE 5+ — Investissements (pas encore implémenté)
    %% ==========================================================================

    %% Instrument { id PK, ticker, nom, type, devise_cotation, isin }
    %% InvestmentPosition { id PK, account_id FK, instrument_id FK, ... }
    %% InvestmentTransaction { id PK, account_id FK, instrument_id FK, ... }
    %% PriceHistory { id PK, instrument_id FK, date, prix_cloture, devise }

    %% ==========================================================================
    %% RELATIONS
    %% ==========================================================================

    %% Users
    CustomUser ||--|| Profile : "a un"

    %% Banks & Accounts
    Bank ||--o{ Account : "héberge"
    Account ||--o| CompteCourant : "spécialisé en"
    Account ||--o{ Card : "émet"
    Account ||--o{ BalanceSnapshot : "historique solde"
    Account ||--o{ ImportLog : "tracé par"
    Account ||--o{ Transaction : "contient"

    %% Cards → Users (qui utilise quelle carte)
    CustomUser ||--o{ Card : "titulaire"
    CustomUser ||--o{ ImportLog : "importe"

    %% Transactions
    Card ||--o{ Transaction : "source"
    Category ||--o{ SubCategory : "contient"
    Category ||--o{ Transaction : "classifie"
    Category ||--o{ CategorizationRule : "cible"
    Category ||--o{ BudgetTarget : "cible"
    SubCategory ||--o{ Transaction : "affine"
    SubCategory ||--o{ CategorizationRule : "affine"
    SubCategory ||--o{ BudgetTarget : "affine"
    CategorizationRule ||--o{ Transaction : "catégorise"
    BudgetTarget ||--o{ BudgetResult : "évalué par"
